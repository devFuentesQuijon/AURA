# ===== Sitio a copilotear (obligatorio para scrapear) =====
# URL de inicio del sitio. De aquí parte el crawler y define el dominio
# permitido en las respuestas del chat.
SITE_URL=https://ejemplo.cl

# Nombre del asistente (default: Aura). El nombre del SITIO se detecta
# solo del scrapeo (og:site_name / título de la home).
ASSISTANT_NAME=Aura

# ===== LLM (cualquier endpoint compatible OpenAI) =====
# Z.ai (GLM) — valores por defecto si no se define nada:
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1
# Modelo del agente pi (investigación de la KB)
PI_MODEL=glm-5.3-flash

# --- Alternativa genérica (LLM local, OpenRouter, vLLM, Ollama…) ---
# Si usas estas variables, déjalas como aliases; el código prefiere ZAI_*
# cuando ambas están definidas. Ejemplo LLM local:
#LLM_API_KEY=sk-local
#LLM_BASE_URL=http://localhost:1234/v1
#LLM_MODEL=qwen2.5-7b-instruct
#PI_MODEL=qwen2.5-7b-instruct

# ===== Datos en vivo (opcional) =====
# Habilita las herramientas del agente que consultan la API REST del sitio
# CON LA CUENTA del usuario que chatea (token JWT vía header X-User-Token).
# La API del sitio aplica los permisos del usuario (403 = sin permiso).
# Solo lectura. Base URL de la API (…/api/v1).
LIVE_API_ENABLED=1
LIVE_API_BASE_URL=http://localhost:5200/api/v1
